modules = ["python-3.11"]

run = "pip install -r sales-crm/backend/requirements.txt -q && cd sales-crm/backend && uvicorn main:app --host 0.0.0.0 --port 8080"

entrypoint = "sales-crm/backend/main.py"

[nix]
channel = "stable-23_11"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
run = ["sh", "-c", "pip install -r sales-crm/backend/requirements.txt -q && cd sales-crm/backend && uvicorn main:app --host 0.0.0.0 --port 8080"]
deploymentTarget = "cloudrun"
